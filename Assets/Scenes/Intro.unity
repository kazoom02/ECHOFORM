  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8c7daa4dfedf37b49adc651a92bb0023, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CutsceneController
  segments:
  - clip: {fileID: 32900000, guid: 02ad9cf91b9675b4abf4c2fa3a28a327, type: 3}
    pages:
    - The world was kept alive by the Loom
    - a machine built to copy living things, so nothing would ever truly die.
  - clip: {fileID: 32900000, guid: 0a45fd12282d6634083ffd9f30a599ff, type: 3}
    pages:
    - It worked. Until it forgot how to stop.
  - clip: {fileID: 32900000, guid: 702ab59c3d81773438d21de8e183b1ee, type: 3}
    pages:
    - The first things it touched were slimes
    - simple cells, never meant to think, now dividing forever."
  - clip: {fileID: 32900000, guid: 2b25eabbbaf263c46ab99694057aeddc, type: 3}
    pages:
    - You are Vestige
    - the ninth copy of a hero who fell long ago.
  - clip: {fileID: 32900000, guid: b364e37d2023b824783b04dc74ac787c, type: 3}
    pages:
    - Each time you die, the Loom prints another you
    - a little more degraded than the last.
  - clip: {fileID: 32900000, guid: 8b0ff0dfc0528f342bb1f5c61aa65ed3, type: 3}
    pages:
    - But you carry the memory-cards of every version before you
    - the accumulated hand of a thousand dead selves.
  - clip: {fileID: 32900000, guid: c6f4c3685aa78c14cb509a1c5e87460e, type: 3}
    pages:
    - To end the copying you must reach the Loom's core and cut the thread. But to
      kill a slime is to make two more.
  - clip: {fileID: 32900000, guid: a04a134398959b6429c2907633eeb600, type: 3}
    pages:
    - Every death is a birth.
  nextScene: FirstArea
  videoPlayer: {fileID: 145192952}
  captionText: {fileID: 1081529174}
  continueButton: {fileID: 1269531240}
